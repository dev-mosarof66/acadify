    {
      "id": "chemistry-9-10-bn-c11-t11.4-p001",
      "kind": "text",
      "section": "১১.৪.১ অ্যালকিন (Alkenes)",
      "caption": null,
      "body": "যে জৈব যৌগের কার্বন শিকলে অন্তত একটি কার্বন-কার্বন দ্বিবন্ধন থাকে তাকে অ্যালকিন বলে। অ্যালকিনের সাধারণ সংকেত $C_nH_{2n}$। অ্যালকিনের নিম্নতর সদস্যগুলো (ইথিন, প্রোপিন ইত্যাদি)",
      "image": null,
      "formulas": [
        "C_nH_{2n}"
      ],
      "pdfPageStart": 277,
      "pdfPageEnd": 277,
      "printedPageStart": 272,
      "printedPageEnd": 272,
      "reviewReasons": [
