    {
      "id": "chemistry-9-10-bn-c11-t11.4-p021",
      "kind": "text",
      "section": "১১.৪.২ অ্যালকাইন (Alkynes)",
      "caption": null,
      "body": "যে জৈব যৌগে কার্বন শিকলে অন্তত একটি কার্বন-কার্বন ত্রিবন্ধন ($-C \\equiv C-$) থাকে তাকে অ্যালকাইন বলে। তাই অ্যালকাইনের সাধারণ সংকেত $C_nH_{2n-2}$। অ্যালকাইন শ্রেণির সূচ্রতম সরল সদস্য ইথাইন ($CH \\equiv CH$) বা এসিটিলিন (acetylene)।",
      "image": null,
      "formulas": [
        "-C \\equiv C-",
        "C_nH_{2n-2}",
        "CH \\equiv CH"
      ],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p022",
      "kind": "text",
      "section": "অ্যালকাইনের নামকরণ",
      "caption": null,
      "body": "অ্যালকেনের নামের শেষের এন (ane) বাদ দিয়ে আইন (yne) যোগ করে অ্যালকাইনের নামকরণ করা হয়। যেমন: $CH \\equiv CH$ এর নাম ইথাইন, $CH_3-C \\equiv CH$ এর নাম প্রোপাইন, $CH_3-C \\equiv C-CH_3$ এর নাম বিউটাইন-২।",
      "image": null,
      "formulas": [
        "CH \\equiv CH",
        "CH_3-C \\equiv CH",
        "CH_3-C \\equiv C-CH_3"
      ],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p023",
      "kind": "text",
      "section": "অ্যালকাইনের প্রস্তুতি",
      "caption": null,
      "body": "ক্যালসিয়াম কার্বাইড থেকে: ক্যালসিয়াম কার্বাইডের মধ্যে পানি যোগ করলে ইথাইন এবং ক্যালসিয়াম হাইড্রোক্সাইড উৎপন্ন হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [],
