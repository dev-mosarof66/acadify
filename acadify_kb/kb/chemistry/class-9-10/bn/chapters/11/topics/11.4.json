      ],
      "needsReview": true
    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p002",
      "kind": "text",
      "section": "১১.৪.১ অ্যালকিন (Alkenes)",
      "caption": null,
      "body": "হ্যালোজেনের (Cl<sub>2</sub>, Br<sub>2</sub>) এর সঙ্গে বিক্রিয়ায় তৈলাক্ত পদার্থ উৎপন্ন করে বলে অ্যালকিনিকে অনেক সময় অলিফিন (Olefin, Greek: Olefiant = oil forming) বলে।",
      "image": null,
      "formulas": [],
