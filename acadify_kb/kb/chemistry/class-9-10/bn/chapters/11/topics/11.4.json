      "kind": "text",
      "section": "অ্যালকিনের রাসায়নিক ধর্ম",
      "caption": null,
      "body": "অ্যালকোহলকে পরিবেশবান্ধব জ্বালানি হিসেবে ব্যবহার করা হয় এবং পেট্রোলিয়াম শিল্পে দ্রাবক হিসেবে ব্যবহার করা হয় বলে এই বিক্রিয়া অত্যন্ত গুরুত্বপূর্ণ।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 279,
      "pdfPageEnd": 279,
      "printedPageStart": 274,
      "printedPageEnd": 274,
      "reviewReasons": [],
