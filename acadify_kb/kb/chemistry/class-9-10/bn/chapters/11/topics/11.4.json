    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p015",
      "kind": "text",
      "section": "অ্যালকিনের রাসায়নিক ধর্ম",
      "caption": null,
      "body": "**ব্রোমিন সংযোজন:** ইথিনের মধ্যে লাল বর্ণের ব্রোমিন দ্রবণ যোগ করলে ইথিন লাল বর্ণের ব্রোমিন দ্রবণের সাথে বিক্রিয়া করে ডাইব্রোমো ইথেন উৎপন্ন করে। এই বিক্রিয়ায় ব্রোমিনের লাল বর্ণ অপসারিত হয়। সকল অসম্পূর্ণ হাইড্রোকার্বন এই বিক্রিয়া প্রদর্শন করে। ইথিন যে অসম্পূর্ণ যৌগ তা এই বিক্রিয়া দ্বারা প্রমাণিত হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 279,
      "pdfPageEnd": 279,
      "printedPageStart": 274,
      "printedPageEnd": 274,
      "reviewReasons": [],
      "needsReview": false
    },
