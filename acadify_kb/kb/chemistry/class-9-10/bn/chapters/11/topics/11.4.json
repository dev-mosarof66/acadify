    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p007",
      "kind": "text",
      "section": "অ্যালকিনের প্রস্তুতি",
      "caption": null,
      "body": "**ইথানল থেকে:** ইথানলের সাথে অতিরিক্ত গাঢ় সালফিউরিক এসিডকে উত্তপ্ত করলে ইথিন এবং পানি উৎপন্ন হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 278,
      "pdfPageEnd": 278,
      "printedPageStart": 273,
      "printedPageEnd": 273,
      "reviewReasons": [],
      "needsReview": false
    },
    {
