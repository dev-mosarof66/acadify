    {
      "id": "chemistry-9-10-bn-c11-t11.4-p005",
      "kind": "text",
      "section": "অ্যালকিনের প্রস্তুতি",
      "caption": null,
      "body": "**ইথাইল ক্লোরাইড থেকে:** ইথাইল ক্লোরাইড এর সাথে সোডিয়াম হাইড্রোক্সাইডের অ্যালকোহলীয় দ্রবণকে উত্তপ্ত করলে ইথিন, সোডিয়াম ক্লোরাইড এবং পানি উৎপন্ন হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 278,
      "pdfPageEnd": 278,
      "printedPageStart": 273,
      "printedPageEnd": 273,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c11-t11.4-p006",
      "kind": "text",
      "section": "অ্যালকিনের প্রস্তুতি",
      "caption": null,
      "body": "$$CH_3-CH_2Cl + NaOH \\xrightarrow{Alcoholic} CH_2=CH_2 + NaCl + H_2O$$\nইথাইল ক্লোরাইড সোডিয়াম হাইড্রোক্সাইড ইথিন সোডিয়াম ক্লোরাইড পানি",
      "image": null,
      "formulas": [
        "CH_3-CH_2Cl + NaOH \\xrightarrow{Alcoholic} CH_2=CH_2 + NaCl + H_2O"
      ],
      "pdfPageStart": 278,
      "pdfPageEnd": 278,
      "printedPageStart": 273,
      "printedPageEnd": 273,
      "reviewReasons": [
