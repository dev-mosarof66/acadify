      "kind": "text",
      "section": "অ্যালকাইনের রাসায়নিক ধর্ম",
      "caption": null,
      "body": "**হাইড্রোজেন সংযোজন:** তোমরা এর মাঝে জেনে গেছ, নিকেল প্রভাবকের উপস্থিতিতে ইথাইনকে হাইড্রোজেনের সাথে ১৮০-২০০°C তাপমাত্রায় উত্তপ্ত করলে ইথেন উৎপন্ন হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [],
      "needsReview": false
