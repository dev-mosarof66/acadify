    {
      "id": "chemistry-9-10-bn-c11-t11.4-p026",
      "kind": "text",
      "section": "অ্যালকাইনের রাসায়নিক ধর্ম",
      "caption": null,
      "body": "অ্যালকাইনে কার্বন-কার্বন ত্রিবন্ধন থাকে। এখানে একটি বন্ধন শক্তিশালী এবং অন্য দুইটি দুর্বল বন্ধন থাকে। অ্যালকাইনে এই দুর্বল বন্ধনগুলো ভেঙে সংযোজন বিক্রিয়ায় অংশগ্রহণ করে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [],
      "needsReview": false
    },
    {
