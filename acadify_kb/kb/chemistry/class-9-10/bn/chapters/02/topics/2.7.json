    {
      "id": "chemistry-9-10-bn-c02-t2.7-p010",
      "kind": "text",
      "section": "ঊর্ধ্বপাতন প্রক্রিয়ার প্রয়োগ",
      "caption": null,
      "body": "কোনো কঠিন পদার্থের মিশ্রণের মধ্যে একটি উদ্বায়ী পদার্থ মিশ্রিত থাকলে ঐ উদ্বায়ী পদার্থকে মিশ্রণ থেকে সহজে পৃথক করা যায়, যেমন - নিশাদল বা অ্যামোনিয়াম ক্লোরাইড (NH<sub>4</sub>Cl) এর সাথে খাদ্য লবণ (NaCl) মিশ্রিত থাকলে ঊর্ধ্বপাতন পদ্ধতির মাধ্যমে নিশাদলকে পৃথক করা যাবে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 37,
      "pdfPageEnd": 37,
      "printedPageStart": 32,
      "printedPageEnd": 32,
      "reviewReasons": [
