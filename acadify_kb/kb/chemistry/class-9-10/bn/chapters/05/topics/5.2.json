{
  "id": "chemistry-9-10-bn-c05-t5.2",
  "key": "5.2",
  "title": "যোজনী বা যোজ্যতা (Valency)",
  "chapter": 5,
  "ordinal": 2,
  "passages": [
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "পূর্বেই উল্লেখ করা হয়েছে যে, বিভিন্ন মৌলের পরমাণুসমূহ একে অপরের সাথে সর্বশেষ কক্ষপথের ইলেকট্রন বর্জন, গ্রহণ অথবা ভাগভাগির মাধ্যমে অণু গঠন করে। অণু গঠনকালে কোনো মৌলের একটি পরমাণুর সাথে অপর একটি মৌলের পরমাণু যুক্ত হওয়ার ক্ষমতাকে যোজনী বা যোজ্যতা বলা হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সাধারণত সব সময় হাইড্রোজেনের যোজনী এক (1) ধরা হয়। কোনো মৌলের একটি পরমাণু যতগুলো H পরমাণু বা Cl পরমাণুর সাথে যুক্ত হতে পারে সেই সংখ্যাই হলো ঐ মৌলের যোজনী বা যোজ্যতা।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "হাইড্রোজেনের একটি পরমাণু ক্লোরিনের একটি পরমাণুর সাথে যুক্ত হয়ে HCl অণু গঠিত হয়, তাই ক্লোরিনের যোজনীও 1 (এক)। আবার অক্সিজেনের একটি পরমাণু হাইড্রোজেনের দুটি পরমাণুর সাথে যুক্ত হয়ে H<sub>2</sub>O তৈরি করে, এজন্য অক্সিজেনের যোজনী 2 (দুই)। একটি Na পরমাণু একটি Cl পরমাণুর সাথে যুক্ত হয়ে NaCl গঠিত হয়। সুতরাং Na এর যোজনী 1 (এক)।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p004",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "একটি পরমাণুর সাথে যতটি অক্সিজেন পরমাণু যুক্ত হয় তার সেই সংখ্যার দ্বিগুণ করলে ঐ পরমাণুর যোজনী বা যোজ্যতা হয়। যেমন- ক্যালসিয়াম (Ca) এর একটি পরমাণু একটি অক্সিজেন (O) পরমাণুর সাথে যুক্ত হয়ে ক্যালসিয়াম অক্সাইড (CaO) তৈরি করে। এখানে অক্সিজেন পরমাণুর সংখ্যা 1 এই সংখ্যাকে 2 দ্বারা গুণ করলে হয় 2। কাজেই ক্যালসিয়ামের যোজনী 2।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p005",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "কিছু কিছু মৌলের একাধিক যোজনী থাকে। কোনো মৌলের একাধিক যোজনী থাকলে সেই মৌলের যোজনীকে পরিবর্তনশীল যোজনী বলা হয়। যেমন- Fe এর পরিবর্তনশীল যোজনী 2 এবং 3।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "chemistry-9-10-bn-c05-t5.2-p006",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "কোনো মৌলের সর্বোচ্চ যোজনী এবং সক্রিয় যোজনার পার্থক্যকে ঐ মৌলের সুপ্ত যোজনী বলা হয়। যেমন: FeCl<sub>2</sub> যোগে Fe এর সক্রিয় যোজনী 2 কিন্তু Fe এর সর্বোচ্চ যোজনী 3। অতএব FeCl<sub>2</sub> যোগে Fe এর সুপ্ত যোজনী 3 - 2 = 1। আবার FeCl<sub>3</sub> যোগে Fe এর সক্রিয় যোজনী 3 কিন্তু Fe এর সর্বোচ্চ যোজনী 3, অতএব FeCl<sub>3</sub> যোগে Fe এর সুপ্ত যোজনী 3 - 3 = 0।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 90,
      "pdfPageEnd": 90,
      "printedPageStart": 85,
      "printedPageEnd": 85,
      "reviewReasons": [],
      "needsReview": false
    },
