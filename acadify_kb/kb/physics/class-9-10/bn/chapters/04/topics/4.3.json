      "kind": "formula",
      "section": "8.3.1 গতিশক্তি (Kinetic Energy)",
      "caption": null,
      "body": "$$s = \\frac{1}{2}at^2  এবং  v = at$$",
      "image": null,
      "formulas": [
        "s = \\frac{1}{2}at^2  এবং  v = at"
