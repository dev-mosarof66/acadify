      "needsReview": false
    },
    {
      "id": "physics-9-10-bn-c04-t4.3-p005",
      "kind": "text",
      "section": "8.3.1 গতিশক্তি (Kinetic Energy)",
      "caption": null,
      "body": "একটা বস্তুর উপর বল প্রয়োগ করে কাজ করা হলে সেখানে কতটুকু গতিশক্তি হবে সেটা আমরা খুব সহজে বের করতে পারি ।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 109,
      "pdfPageEnd": 109,
      "printedPageStart": 104,
      "printedPageEnd": 104,
      "reviewReasons": [],
      "needsReview": false
