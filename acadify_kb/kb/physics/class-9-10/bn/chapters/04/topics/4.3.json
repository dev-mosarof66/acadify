    {
      "id": "physics-9-10-bn-c04-t4.3-p006",
      "kind": "text",
      "section": "8.3.1 গতিশক্তি (Kinetic Energy)",
      "caption": null,
      "body": "ধরা যাক $F$ বল প্রয়োগ করে $m$ ভরের একটা বস্তুরকে $s$ দূরত্ব সরানো হলো । তাহলে এই $F$ বলের সম্পাদিত কাজ $W$ হচ্ছে",
      "image": null,
      "formulas": [
        "F",
        "m",
        "s",
        "F",
        "W"
      ],
      "pdfPageStart": 109,
      "pdfPageEnd": 109,
      "printedPageStart": 104,
