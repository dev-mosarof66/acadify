  "title": "পূর্ণ অভ্যন্তরীণ প্রতিফলন (Total Internal Reflection)",
  "chapter": 9,
  "ordinal": 2,
  "passages": [
    {
      "id": "physics-9-10-bn-c09-t9.2-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "প্রতিফলন সম্পর্কে আলোচনা করার সময় বলা হয়েছিল যখন অত্যন্ত নির্খুত এবং পূর্ণাঙ্গ প্রতিফলন প্রয়োজন হয়, তখন আয়না ব্যবহার না করে পুরোপরি সচ্ছ মাধ্যম ব্যবহার করে এক ধরনের প্রতিফলন করানো হয়। এই প্রতিফলনের নাম পূর্ণ অভ্যন্তরীণ প্রতিফলন। এটি অত্যন্ত সহজ এবং চমকপ্রদ একটি প্রক্রিয়া, যেখানে প্রতিসরণের নিয়ম ব্যবহার করে আলোক রশ্মিটি ঘন মাধ্যম থেকে হালকা মাধ্যমে পাঠাতে হয় মাত্র।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 253,
      "pdfPageEnd": 253,
      "printedPageStart": 248,
      "printedPageEnd": 248,
      "reviewReasons": [],
      "needsReview": false
    },
