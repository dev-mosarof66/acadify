    {
      "id": "physics-9-10-bn-c10-t10.5-p013",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "(c) বলরেখাগুলো যত কাছাকাছি থাকবে তড়িৎ ক্ষেত্রের মান তত বেশি হবে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 289,
