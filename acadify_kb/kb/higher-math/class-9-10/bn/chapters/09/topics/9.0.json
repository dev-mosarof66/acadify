    {
      "id": "higher-math-9-10-bn-c09-t9.0-p009",
      "kind": "text",
      "section": "মূলদ ও অমূলদ সূচক",
      "caption": null,
      "body": "ধরি $a$ একটি পূর্ণ সংখ্যা বা ভগ্নাংশ বা ধনাত্মক বা ঋণাত্মক হতে পারে এবং $n$ একটি ধনাত্মক পূর্ণসংখ্যা। তাহলে $a$ কে $n$ বার গুণ করলে গুণফলটিকে লিখা হয় $a^n = a \\cdot a \\cdot a \\cdots$ ($n$ বার) এবং $a^n$ কে বলা হয় $a$ এর $n$ ঘাত। এরূপ ক্ষেত্রে $a$ কে বলা হয় নিধান বা ভিত্তি (base) এবং $n$ কে বলা হয় $a$ এর ঘাত বা সূচক (exponent)।",
      "image": null,
      "formulas": [
        "a",
        "n",
        "a",
        "n",
        "a^n = a \\cdot a \\cdot a \\cdots",
        "n",
        "a^n",
        "a",
        "n",
        "a",
        "n",
        "a"
      ],
      "pdfPageStart": 199,
      "pdfPageEnd": 199,
      "printedPageStart": 194,
      "printedPageEnd": 194,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
