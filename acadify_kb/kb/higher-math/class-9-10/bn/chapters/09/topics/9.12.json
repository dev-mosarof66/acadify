  "passages": [
    {
      "id": "higher-math-9-10-bn-c09-t9.12-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "কোনো সমতলে কোনো ফাংশনকে জ্যামিতিকভাবে উপস্থাপন করা গেলে ঐ ফাংশনকে চেনা যায়। ফাংশনের জ্যামিতিকভাবে এই উপস্থাপনকে ফাংশনের লেখচিত্র অঙ্কন করা হয়েছে বলা হয়। এখানে সূচক, লগারিদম ও পরমমান ফাংশনের লেখচিত্রের অঙ্কন পদ্ধতি নিয়ে আলোচনা করা হলো।",
      "image": null,
      "formulas": [],
