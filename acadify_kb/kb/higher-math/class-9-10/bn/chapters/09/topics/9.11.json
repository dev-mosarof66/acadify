    {
      "id": "higher-math-9-10-bn-c09-t9.11-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "যেকোনো বাস্তব সংখ্যা $x$ এর মান শূন্য, ধনাত্মক বা ঋণাত্মক। কিন্তু $x$ এর পরমমান সবসময়ই শূন্য বা ধনাত্মক। $x$ এর পরমমানকে $|x|$ দ্বারা প্রকাশ করা হয় এবং পরমমান নিম্নলিখিতভাবে সংজ্ঞায়িত করা হয়।",
      "image": null,
      "formulas": [
        "x",
        "x",
        "x",
        "|x|"
      ],
      "pdfPageStart": 220,
      "pdfPageEnd": 220,
      "printedPageStart": 215,
      "printedPageEnd": 215,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
