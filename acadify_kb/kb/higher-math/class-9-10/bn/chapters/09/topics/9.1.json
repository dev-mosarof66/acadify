  "title": "অমূলদ সূচক",
  "chapter": 9,
  "ordinal": 1,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c09-t9.1-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "অমূলদ সূচকের ক্ষেত্রে $a^x$ ($a > 0$) এর মান এমনভাবে নির্দিষ্ট করা হয় যে, $x$ এর মূলদ আসন্ন মান $p$ এর জন্য $a^p$ এর মান $a^x$ এর মানের আসন্ন হয়। উদাহরণস্বরূপ $3^{\\sqrt{5}}$ সংখ্যাটি বিবেচনা করি। আমরা জানি, $\\sqrt{5}$ একটি অমূলদ সংখ্যা এবং $\\sqrt{5} = 2.236067977 \\cdots$ (এই মান ক্যালকুলেটর ব্যবহার করে পাওয়া গিয়েছে এবং দশমিক বিস্তার যে অনন্ত তা $\\cdots$ দ্বারা নির্দেশ করা হয়েছে)। $\\sqrt{5}$ এর মান হিসেবে",
      "image": null,
      "formulas": [
        "a^x",
        "a > 0",
        "x",
        "p",
        "a^p",
        "a^x",
        "3^{\\sqrt{5}}",
        "\\sqrt{5}",
        "\\sqrt{5} = 2.236067977 \\cdots",
        "\\cdots",
        "\\sqrt{5}"
      ],
      "pdfPageStart": 199,
