      "id": "higher-math-9-10-bn-c09-t9.8-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সারণি ১ এ বর্ণিত $x$ এর ভিন্ন ভিন্ন মানের জন্য $y$ এর মানগুলোর অন্তর সমান যা দ্বারা $y = 2x$ ফাংশানটি বর্ণিত হয়েছে। এটা একটি সরলরেখার সমীকরণ।",
      "image": null,
      "formulas": [
        "x",
        "y",
        "y = 2x"
      ],
      "pdfPageStart": 217,
      "pdfPageEnd": 217,
      "printedPageStart": 212,
      "printedPageEnd": 212,
      "reviewReasons": [
