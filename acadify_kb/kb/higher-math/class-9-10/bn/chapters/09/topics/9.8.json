      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c09-t9.8-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সারণি ২ এ বর্ণিত $(x,y)$ ক্রমজোড়ের মানগুলো দ্বারা দ্বিঘাত সমীকরণ $y = x^2$ ফাংশানটি বর্ণিত হয়েছে।",
      "image": null,
      "formulas": [
        "(x,y)",
        "y = x^2"
      ],
      "pdfPageStart": 217,
      "pdfPageEnd": 217,
      "printedPageStart": 212,
