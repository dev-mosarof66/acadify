    {
      "id": "higher-math-9-10-bn-c09-t9.6-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "১. $\\log_a a = 1$ এবং $\\log_a 1 = 0$",
      "image": null,
      "formulas": [
        "\\log_a a = 1",
        "\\log_a 1 = 0"
