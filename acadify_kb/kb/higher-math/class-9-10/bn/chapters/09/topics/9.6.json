      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** ধরি, $p = a^{\\log_k b - \\log_k c} \\times b^{\\log_k c - \\log_k a} \\times c^{\\log_k a - \\log_k b}$",
      "image": null,
      "formulas": [
        "p = a^{\\log_k b - \\log_k c} \\times b^{\\log_k c - \\log_k a} \\times c^{\\log_k a - \\log_k b}"
      ],
      "pdfPageStart": 214,
      "pdfPageEnd": 214,
      "printedPageStart": 209,
      "printedPageEnd": 209,
      "reviewReasons": [
        "verify-formula"
