    {
      "id": "higher-math-9-10-bn-c09-t9.6-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "২. $\\log_a (M \\times N) = \\log_a M + \\log_a N$",
      "image": null,
