      "kind": "text",
      "section": null,
      "caption": null,
      "body": "তাহলে, $\\log_k p = (\\log_k b - \\log_k c) \\log_k a + (\\log_k c - \\log_k a) \\log_k b + (\\log_k a - \\log_k b) \\log_k c$",
      "image": null,
      "formulas": [
        "\\log_k p = (\\log_k b - \\log_k c) \\log_k a + (\\log_k c - \\log_k a) \\log_k b + (\\log_k a - \\log_k b) \\log_k c"
      ],
      "pdfPageStart": 214,
      "pdfPageEnd": 214,
      "printedPageStart": 209,
      "printedPageEnd": 209,
      "reviewReasons": [
        "verify-formula"
