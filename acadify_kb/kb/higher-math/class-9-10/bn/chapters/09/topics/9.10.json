      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c09-t9.10-p015",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** যেহেতু লগারিদম শুধুমাত্র ধনাত্মক বাস্তব সংখ্যার জন্য সংজ্ঞায়িত হয়",
      "image": null,
