    {
      "id": "higher-math-9-10-bn-c09-t9.10-p017",
      "kind": "figure",
      "section": null,
      "caption": null,
      "body": "drawing: A number line diagram showing a closed interval between -a and a.",
      "image": null,
      "formulas": [],
      "pdfPageStart": 219,
      "pdfPageEnd": 219,
      "printedPageStart": 214,
      "printedPageEnd": 214,
