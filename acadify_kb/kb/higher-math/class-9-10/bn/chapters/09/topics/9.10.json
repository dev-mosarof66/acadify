    {
      "id": "higher-math-9-10-bn-c09-t9.10-p012",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$f(x) = \\frac{x}{|x|} = \\begin{cases} \\frac{x}{x} = 1, & যখন  x > 0 \\\\ \\frac{x}{-x} = -1, & যখন  x < 0 \\end{cases}$$",
      "image": null,
      "formulas": [
        "f(x) = \\frac{x}{|x|} = \\begin{cases} \\frac{x}{x} = 1, & যখন  x > 0 \\\\ \\frac{x}{-x} = -1, & যখন  x < 0 \\end{cases}"
      ],
      "pdfPageStart": 219,
      "pdfPageEnd": 219,
      "printedPageStart": 214,
      "printedPageEnd": 214,
      "reviewReasons": [
