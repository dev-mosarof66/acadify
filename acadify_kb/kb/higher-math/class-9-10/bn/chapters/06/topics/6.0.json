      "kind": "text",
      "section": "বাস্তব সংখ্যার ক্ষেত্রে",
      "caption": null,
      "body": "$a > b$ যদি ও কেবল যদি $(a - b)$ ধনাত্মক অর্থাৎ $(a - b) > 0$",
      "image": null,
      "formulas": [
        "a > b",
        "(a - b)",
        "(a - b) > 0"
      ],
