  "passages": [
    {
      "id": "higher-math-9-10-bn-c06-t6.1-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সমীকরণের সাহায্যে তোমরা সমস্যা সমাধান করতে শিখেছ। একই পদ্ধতিতে অসমতা সম্পর্কিত সমস্যার সমাধান করতে পারবে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 131,
      "pdfPageEnd": 131,
      "printedPageStart": 126,
      "printedPageEnd": 126,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c06-t6.1-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**উদাহরণ ৬.** কোনো পরীক্ষায় বাংলা ১ম ও ২য় পত্র রমা পেয়েছে যথাক্রমে $5x$ এবং $6x$ নম্বর এবং কুমকুম পেয়েছে $4x$ এবং ৮৪ নম্বর। কোনো পত্র কেউ ৪০ এর নিচে পায়নি। বাংলা বিষয়ে কুমকুম হয়েছে প্রথম এবং রমা হয়েছে দ্বিতীয়। $x$ এর মান সন্বায় অসমতার মাধ্যমে প্রকাশ করো।",
      "image": null,
      "formulas": [
        "5x",
        "6x",
        "4x",
        "x"
      ],
      "pdfPageStart": 131,
      "pdfPageEnd": 131,
      "printedPageStart": 126,
      "printedPageEnd": 126,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c06-t6.1-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** রমা পেয়েছে মোট $5x + 6x$ নম্বর এবং কুমকুম পেয়েছে মোট $4x + 84$ নম্বর।",
      "image": null,
      "formulas": [
        "5x + 6x",
        "4x + 84"
      ],
      "pdfPageStart": 131,
      "pdfPageEnd": 131,
      "printedPageStart": 126,
