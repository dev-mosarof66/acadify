{"id":"higher-math-9-10-bn-c08-t8.ex-p025","chapter":8,"chapterTitle":"ত্রিকোণমিতি","topic":"8.ex","topicTitle":"অনুশীলনী ৮.১","section":"অনুশীলনী ৮.২","kind":"exercise","page":175,"text":"খ) $\\sqrt{\\frac{1 + \\cos \\theta}{1 - \\cos \\theta}} = cosec \\theta + \\cot \\theta = \\sqrt{\\frac{\\sec \\theta + 1}{\\sec \\theta - 1}}$","image":null,"verified":false,"reviewReasons":["verify-formula"]}
{"id":"higher-math-9-10-bn-c08-t8.ex-p026","chapter":8,"chapterTitle":"ত্রিকোণমিতি","topic":"8.ex","topicTitle":"অনুশীলনী ৮.১","section":"অনুশীলনী ৮.২","kind":"exercise","page":175,"text":"গ) $\\sqrt{\\frac{1 - \\sin A}{1 + \\sin A}} = \\sec A - \\tan A$","image":null,"verified":false,"reviewReasons":["verify-formula"]}
