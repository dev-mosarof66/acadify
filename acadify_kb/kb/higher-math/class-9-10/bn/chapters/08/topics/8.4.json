      "image": null,
      "formulas": [
        "D^\\circ",
        "R^c",
        "D^\\circ = \\left( D \\times \\frac{\\pi}{180} \\right)^c = R^c",
        "D \\times \\frac{\\pi}{180} = R",
        "\\frac{D}{180} = \\frac{R}{\\pi}"
      ],
      "pdfPageStart": 160,
