  "passages": [
    {
      "id": "higher-math-9-10-bn-c08-t8.5-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ত্রিকোণমিতির এই অংশে প্রথমে সূক্ষ্মকোণের ক্ষেত্রে ত্রিকোণমিতিক অনুপাতসমূহ (sine, cosine, tangent, secant, cosecant, cotangent) সম্পর্কে আলোচনা করা হবে। সূক্ষ্মকোণের অনুপাতসমূহের মাধ্যমে যেকোনো কোণের ত্রিকোণমিতিক অনুপাতসমূহ নির্ণয়ের কৌশল আলোচনা করা হবে। অনুপাতসমূহের পারস্পরিক সম্পর্ক এবং বিভিন্ন চতুর্ভাগে এদের চিহ্ন কি হবে সে সম্পর্কে ব্যাখ্যা করা হবে। ত্রিকোণমিতিক অনুপাত সংক্রান্ত কতিপয় অভেদ সম্পর্কে ধারণা দেওয়া হবে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 165,
      "pdfPageEnd": 165,
      "printedPageStart": 160,
      "printedPageEnd": 160,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c08-t8.5-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "এছাড়াও আদর্শ কোণসমূহের $(0, \\frac{\\pi}{6}, \\frac{\\pi}{4}, \\frac{\\pi}{3}, \\frac{\\pi}{2})$ ত্রিকোণমিতিক অনুপাত এবং অনুপাতসমূহের সর্বোচ্চ বা সর্বনিম্নমান অর্থাৎ মানের পরিধি সম্পর্কে আলোচনাও এই অংশে অন্তর্ভুক্ত থাকবে।",
      "image": null,
      "formulas": [
