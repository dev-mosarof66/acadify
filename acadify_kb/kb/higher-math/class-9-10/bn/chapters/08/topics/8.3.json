  "passages": [
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p001",
      "kind": "definition",
      "section": null,
      "caption": null,
      "body": "**সংজ্ঞা ১.** বৃত্তীয় পদ্ধতিতে (circular system) অর্থাৎ, রেডিয়ান এককে কোনো কোণের পরিমাপকে তার বৃত্তীয় পরিমাপ (circular measure) বলা হয়।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
      "printedPageEnd": 153,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "মনে করি, $\\angle MON$ যেকোনো একটি কোণ যার বৃত্তীয় পরিমাপ নির্ণয় করতে হবে। $O$ বিন্দুকে কেন্দ্র করে $OA = r$ ব্যাসার্ধ নিয়ে একটি বৃত্ত অঙ্কন করি। বৃত্তটি $OM$ ও $ON$ কে যথাক্রমে $A$ ও $B$ বিন্দুতে ছেদ করে। তাহলে $AB$ চাপ দ্বারা উৎপন্ন কেন্দ্রস্থ কোণ $\\angle AOB$। ব্যাসার্ধ $r$ এর সমান করে $AP$ চাপ নিই (চাপ ও ব্যাসার্ধ একই এককে হতে হবে)।",
      "image": null,
      "formulas": [
        "\\angle MON",
        "O",
        "OA = r",
        "OM",
        "ON",
        "A",
        "B",
        "AB",
        "\\angle AOB",
        "r",
        "AP"
      ],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
      "printedPageEnd": 153,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
