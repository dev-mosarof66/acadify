    {
      "id": "higher-math-9-10-bn-c08-t8.3-p006",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**প্রতিজ্ঞা ২** অনুযায়ী,",
      "image": null,
      "formulas": [],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
