      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$= \\frac{s}{r} \\times 1  রেডিয়ান = \\frac{s}{r}  রেডিয়ান$$",
      "image": null,
      "formulas": [
        "= \\frac{s}{r} \\times 1  রেডিয়ান = \\frac{s}{r}  রেডিয়ান"
