    },
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p010",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$\\therefore \\angle MON$ এর বৃত্তীয় পরিমাপ $\\frac{s}{r}$, যেখানে কোণটি তার শীর্ষবিন্দুকে কেন্দ্র করে এবং $r$ ব্যাসার্ধ নিয়ে অঙ্কিত বৃত্তে $s$ পরিমাণ চাপ খণ্ডিত করে।",
      "image": null,
      "formulas": [
        "\\therefore \\angle MON",
        "\\frac{s}{r}",
        "r",
        "s"
      ],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
      "printedPageEnd": 153,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p011",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**প্রতিজ্ঞা ৪.** $r$ ব্যাসার্ধের কোনো বৃত্তে $s$ দৈর্ঘ্যের কোনো চাপ কেন্দ্রে $\\theta$ পরিমাণ কোণ উৎপন্ন করলে $s = r\\theta$ হবে।",
      "image": null,
      "formulas": [
        "r",
        "s",
        "\\theta",
        "s = r\\theta"
      ],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
