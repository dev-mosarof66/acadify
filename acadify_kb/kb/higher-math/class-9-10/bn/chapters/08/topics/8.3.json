    },
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p007",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$\\frac{\\angle MON}{\\angle AOP} = \\frac{চাপ  AB}{চাপ  AP} = \\frac{চাপ  AB}{ব্যাসার্ধ  OA} = \\frac{s}{r}$$",
      "image": null,
      "formulas": [
        "\\frac{\\angle MON}{\\angle AOP} = \\frac{চাপ  AB}{চাপ  AP} = \\frac{চাপ  AB}{ব্যাসার্ধ  OA} = \\frac{s}{r}"
      ],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
      "printedPageEnd": 153,
      "reviewReasons": [
        "latin-junk",
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c08-t8.3-p008",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$\\therefore \\angle MON = \\frac{s}{r} \\times \\angle AOP$$",
      "image": null,
      "formulas": [
        "\\therefore \\angle MON = \\frac{s}{r} \\times \\angle AOP"
      ],
      "pdfPageStart": 158,
      "pdfPageEnd": 158,
      "printedPageStart": 153,
      "printedPageEnd": 153,
      "reviewReasons": [
        "verify-formula"
