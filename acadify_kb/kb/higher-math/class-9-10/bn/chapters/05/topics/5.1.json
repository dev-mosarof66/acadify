      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** $ax^2 + bx + c = 0$ সমীকরণের সাথে তুলনা করে এক্ষেত্রে পাওয়া যায় $a = 1, b = -5$ এবং $c = 6$। অতএব সমীকরণটির সমাধান",
      "image": null,
      "formulas": [
        "ax^2 + bx + c = 0",
        "a = 1, b = -5",
        "c = 6"
      ],
      "pdfPageStart": 103,
      "pdfPageEnd": 103,
      "printedPageStart": 98,
      "printedPageEnd": 98,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
