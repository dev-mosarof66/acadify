      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**উদাহরণ ৩৩.** লেখচিত্রের সাহায্যে $x^2 - 5x + 4 = 0$ এর সমাধান করো।",
      "image": null,
      "formulas": [
        "x^2 - 5x + 4 = 0"
      ],
      "pdfPageStart": 121,
      "pdfPageEnd": 121,
      "printedPageStart": 116,
      "printedPageEnd": 116,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
