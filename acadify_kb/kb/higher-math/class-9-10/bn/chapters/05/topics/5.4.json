  "passages": [
    {
      "id": "higher-math-9-10-bn-c05-t5.4-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "দুই চলকবিশিষ্ট দুটি একঘাত সমীকরণ অথবা একটি একঘাত ও একটি দ্বিঘাত সমীকরণ সমস্যায় গঠিত জোটির সমাধান নির্ণয় পদ্ধতি নবম-দশম শ্রেণির গণিত বইয়ে আলোচনা করা হয়েছে। এখানে এরূপ দুটি দ্বিঘাত সমীকরণ সমস্যায় গঠিত কতিপয় জোটির সমাধান নির্ণয় আলোচনা করা হলো।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 111,
      "pdfPageEnd": 111,
      "printedPageStart": 106,
      "printedPageEnd": 106,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.4-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "উল্লেখ্য যে, চলক দুইটি $x$ ও $y$ হলে $(x, y) = (a, b)$ এরূপ আকারে জোটির একটি সমাধান যদি সমীকরণ দুটিতে $x$ এর স্থানে $a$ এবং $y$ এর স্থানে $b$ বসালে তাদের উভয় পক্ষ সমান হয়।",
      "image": null,
      "formulas": [
        "x",
        "y",
        "(x, y) = (a, b)",
        "x",
        "a",
        "y",
        "b"
      ],
