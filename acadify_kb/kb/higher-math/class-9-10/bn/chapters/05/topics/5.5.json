    {
      "id": "higher-math-9-10-bn-c05-t5.5-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সহসমীকরণের ধারণা ব্যবহার করে দৈনন্দিন জীবনের বহু সমস্যার সমাধান করা যায়। অনেক সময় সমস্যায় দুটি অজ্ঞাত রাশির মান নির্ণয় করতে হয়। সেক্ষেত্রে অজ্ঞাত রাশি দুটি $x$ এবং $y$ বা অন্য যেকোনো দুটি স্বতন্ত্র প্রতীক ধরতে হয়। তারপর সমস্যার শর্ত বা শর্তগুলো থেকে পরস্পর অনির্ভর, সঞ্জাতিপূর্ণ সমীকরণ গঠন করে সমীকরণ জোটির সমাধান করলেই অজ্ঞাত রাশি $x$ এবং $y$ এর মান পাওয়া যায়।",
      "image": null,
      "formulas": [
        "x",
        "y",
        "x",
        "y"
      ],
      "pdfPageStart": 115,
      "pdfPageEnd": 115,
      "printedPageStart": 110,
      "printedPageEnd": 110,
      "reviewReasons": [
