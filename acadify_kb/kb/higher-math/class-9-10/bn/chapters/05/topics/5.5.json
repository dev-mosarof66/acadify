      "kind": "text",
      "section": null,
      "caption": null,
      "body": "এবং, $(x - y)^2 = x^2 + y^2 - 2xy = 650 - 646 = 4$",
      "image": null,
      "formulas": [
        "(x - y)^2 = x^2 + y^2 - 2xy = 650 - 646 = 4"
