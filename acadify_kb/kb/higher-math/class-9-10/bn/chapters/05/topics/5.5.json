      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$\\therefore (x + y) = 36 \\dots (3)$ এবং $(x - y) = \\pm 2 \\dots (4)$",
      "image": null,
      "formulas": [
        "\\therefore (x + y) = 36 \\dots (3)",
