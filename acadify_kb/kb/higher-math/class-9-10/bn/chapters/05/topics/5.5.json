    },
    {
      "id": "higher-math-9-10-bn-c05-t5.5-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**উদাহরণ ২৪.** দুটি বর্গক্ষেত্রের ক্ষেত্রফলের সমষ্টি 650 বর্গমিটার। ঐ দুটি বর্গক্ষেত্রের দুই বাহু দ্বারা গঠিত আয়তক্ষেত্রের ক্ষেত্রফল 323 বর্গমিটার হলে, বর্গক্ষেত্র দুটির প্রত্যেক বাহুর দৈর্ঘ্য কত?",
      "image": null,
      "formulas": [],
      "pdfPageStart": 115,
      "pdfPageEnd": 115,
      "printedPageStart": 110,
      "printedPageEnd": 110,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.5-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** মনে করি, একটি বর্গক্ষেত্রের বাহুর দৈর্ঘ্য $x$ মিটার এবং অপরটির বাহুর দৈর্ঘ্য $y$ মিটার।",
      "image": null,
      "formulas": [
        "x",
        "y"
      ],
      "pdfPageStart": 115,
      "pdfPageEnd": 115,
      "printedPageStart": 110,
      "printedPageEnd": 110,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.5-p004",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "প্রশ্নমতে, $x^2 + y^2 = 650 \\dots (1)$",
      "image": null,
      "formulas": [
        "x^2 + y^2 = 650 \\dots (1)"
      ],
      "pdfPageStart": 115,
      "pdfPageEnd": 115,
      "printedPageStart": 110,
      "printedPageEnd": 110,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.5-p005",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "এবং, $xy = 323 \\dots (2)$",
      "image": null,
      "formulas": [
        "xy = 323 \\dots (2)"
