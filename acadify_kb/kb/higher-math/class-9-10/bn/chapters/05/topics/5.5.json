      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.5-p006",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$\\therefore (x + y)^2 = x^2 + y^2 + 2xy = 650 + 646 = 1296$",
      "image": null,
      "formulas": [
        "\\therefore (x + y)^2 = x^2 + y^2 + 2xy = 650 + 646 = 1296"
      ],
      "pdfPageStart": 115,
      "pdfPageEnd": 115,
      "printedPageStart": 110,
      "printedPageEnd": 110,
      "reviewReasons": [
        "verify-formula"
