  "passages": [
    {
      "id": "higher-math-9-10-bn-c05-t5.3-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "যে সমীকরণে অঞ্জাত চলক সূচকরূপে থাকে, তাকে সূচক সমীকরণ বলে। $2^x = 8$, $16^x = 4^{x+2}$, $2^{x+1} - 2^x - 8 = 0$ সমীকরণগুলো সূচক সমীকরণ যেখানে $x$ অঞ্জাত চলক। সূচক সমীকরণ সমাধান করতে সূচকের নিম্নলিখিত ধর্মটি প্রায়ই ব্যবহার করা হয়:",
      "image": null,
      "formulas": [
        "2^x = 8",
        "16^x = 4^{x+2}",
        "2^{x+1} - 2^x - 8 = 0",
        "x"
      ],
      "pdfPageStart": 107,
      "pdfPageEnd": 108,
      "printedPageStart": 102,
      "printedPageEnd": 103,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c05-t5.3-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$a > 0, a \\neq 1$ হলে $a^x = a^m$ হবে যদি ও কেবল যদি $x = m$ হয়। এ জন্য প্রথমে সমীকরণের উভয় পক্ষকে একই সংখ্যার ঘাত রূপে প্রকাশ করা হয়।",
      "image": null,
      "formulas": [
        "a > 0, a \\neq 1",
        "a^x = a^m",
        "x = m"
      ],
      "pdfPageStart": 108,
      "pdfPageEnd": 108,
