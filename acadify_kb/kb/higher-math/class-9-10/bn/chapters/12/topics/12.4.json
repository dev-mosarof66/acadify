    },
    {
      "id": "higher-math-9-10-bn-c12-t12.4-p002",
      "kind": "figure",
      "section": null,
      "caption": null,
      "body": "drawing: A line segment connecting points A and B, with a vector u pointing from A to B and a vector -u pointing from B to A.",
      "image": null,
      "formulas": [],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [],
