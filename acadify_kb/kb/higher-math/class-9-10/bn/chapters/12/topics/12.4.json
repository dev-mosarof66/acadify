  "title": "শূন্য ভেক্টর",
  "chapter": 12,
  "ordinal": 4,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c12-t12.4-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "যে ভেক্টরের মান শূন্য এবং যার দিক নির্ণয় করা যায় না তাকে শূন্য ভেক্টর বলে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 280,
      "pdfPageEnd": 280,
      "printedPageStart": 275,
      "printedPageEnd": 275,
      "reviewReasons": [],
