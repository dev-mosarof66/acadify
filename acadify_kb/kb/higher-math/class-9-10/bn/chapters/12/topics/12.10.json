      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "$<u>a</u> - <u>c</u>$ ও $<u>b</u> - <u>d</u>$ দুটি সমান অশূন্য ভেক্টর হলে তাদের ধারক রেখা একই অথবা সমান্তরাল হবে। কিন্তু $AC, BD$ দুইটি পরস্পরচ্ছেদী অসমান্তরাল সরলরেখা। সুতরাং $<u>a</u> - <u>c</u>$ ও $<u>b</u> - <u>d</u>$ ভেক্টরদ্বয় অশূন্য হতে পারে না বিধায় এদের মান শূন্য হবে।",
      "image": null,
      "formulas": [
        "<u>a</u> - <u>c</u>",
        "<u>b</u> - <u>d</u>",
        "AC, BD",
        "<u>a</u> - <u>c</u>",
        "<u>b</u> - <u>d</u>"
      ],
      "pdfPageStart": 288,
      "pdfPageEnd": 288,
      "printedPageStart": 283,
