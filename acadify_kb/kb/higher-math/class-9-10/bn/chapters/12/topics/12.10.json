    {
      "id": "higher-math-9-10-bn-c12-t12.10-p023",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "**উদাহরণ ৩.** ভেক্টরের সাহায্যে প্রমাণ করো যে, ত্রিভুজের যেকোনো দুই বাহুর মধ্যবিন্দুদ্বয়ের সংযোজক রেখাংশ ঐ ত্রিভুজের তৃতীয় বাহুর সমান্তরাল ও তার অর্ধেক।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 287,
      "pdfPageEnd": 287,
      "printedPageStart": 282,
      "printedPageEnd": 282,
      "reviewReasons": [],
      "needsReview": false
