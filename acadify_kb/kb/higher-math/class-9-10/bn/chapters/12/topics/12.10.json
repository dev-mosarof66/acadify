    {
      "id": "higher-math-9-10-bn-c12-t12.10-p024",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "**সমাধান:** মনে করি, $ABC$ ত্রিভুজের $AB$ ও $AC$ বাহুদ্বয়ের মধ্যবিন্দু যথাক্রমে $D$ ও $E$। $D$ ও $E$ যোগ করি। প্রমাণ করতে হবে যে, $DE \\parallel BC$ এবং $DE = \\frac{1}{2}BC$।",
      "image": null,
      "formulas": [
        "ABC",
        "AB",
        "AC",
        "D",
        "E",
        "D",
        "E",
        "DE \\parallel BC",
        "DE = \\frac{1}{2}BC"
      ],
      "pdfPageStart": 287,
      "pdfPageEnd": 287,
      "printedPageStart": 282,
      "printedPageEnd": 282,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c12-t12.10-p025",
      "kind": "figure",
      "section": "সমাধান:",
      "caption": null,
      "body": "drawing: A triangle ABC with midpoints D and E on sides AB and AC respectively, and a line segment DE connecting them.",
      "image": "p287-page_12_image_2_v2.jpg",
      "formulas": [],
      "pdfPageStart": 287,
      "pdfPageEnd": 287,
      "printedPageStart": 282,
      "printedPageEnd": 282,
