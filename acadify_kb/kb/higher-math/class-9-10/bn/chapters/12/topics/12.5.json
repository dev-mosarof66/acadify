      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**প্রমাণ:** যেহেতু $<u>u</u> + <u>v</u> = <u>u</u> + <u>w</u>$",
      "image": null,
      "formulas": [
        "<u>u</u> + <u>v</u> = <u>u</u> + <u>w</u>"
      ],
      "pdfPageStart": 282,
