    },
    {
      "id": "higher-math-9-10-bn-c12-t12.5-p019",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "বা, $<u>u</u> - <u>u</u> + <u>v</u> = <u>u</u> - <u>u</u> + <u>w</u>$ অর্থাৎ $<u>v</u> = <u>w</u>$",
      "image": null,
