    {
      "id": "higher-math-9-10-bn-c12-t12.5-p018",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$\\therefore <u>u</u> + <u>v</u> + (-<u>u</u>) = <u>u</u> + <u>w</u> + (-<u>u</u>)$ [উভয়পক্ষে $-<u>u</u>$ যোগ করে]",
      "image": null,
      "formulas": [
