    {
      "id": "higher-math-9-10-bn-c12-t12.7-p008",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$AB$ কে $C$ পর্যন্ত বর্ধিত করি যেন $|\\overrightarrow{BC}| = n|<u>u</u>|$ হয় $\\quad \\therefore \\overrightarrow{BC} = n<u>u</u>$",
      "image": null,
      "formulas": [
        "AB",
        "C",
        "|\\overrightarrow{BC}| = n|<u>u</u>|",
