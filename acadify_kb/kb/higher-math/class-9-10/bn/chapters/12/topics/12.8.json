    {
      "id": "higher-math-9-10-bn-c12-t12.8-p009",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$\\therefore m<u>u</u> + m<u>v</u> = m(<u>u</u> + <u>v</u>)$",
      "image": null,
      "formulas": [
        "\\therefore m<u>u</u> + m<u>v</u> = m(<u>u</u> + <u>v</u>)"
