      "kind": "text",
      "section": null,
      "caption": null,
      "body": "বা, $m(\\overrightarrow{OA}) + m(\\overrightarrow{AB}) = m(\\overrightarrow{OB})$",
      "image": null,
      "formulas": [
        "m(\\overrightarrow{OA}) + m(\\overrightarrow{AB}) = m(\\overrightarrow{OB})"
      ],
      "pdfPageStart": 284,
      "pdfPageEnd": 284,
      "printedPageStart": 279,
