    {
      "id": "higher-math-9-10-bn-c12-t12.1-p011",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**দ্রষ্টব্য:** যেকোনো বিন্দু থেকে প্রদত্ত যেকোনো ভেক্টরের সমান করে একটি ভেক্টর টানা যায়। কেননা, বিন্দু $P$ এবং ভেক্টর $<u>u</u>$ দেওয়া থাকলে, আমরা $P$ বিন্দু দিয়ে $<u>u</u>$ এর ধারকের সমান্তরাল করে একটি সরলরেখা টানি, তারপর $P$ বিন্দু থেকে $<u>u</u>$ এর দিক বরাবর $|<u>u</u>|$ এর সমান করে $PQ$ রেখাংশ কেটে নিই। তাহলে অঙ্কন অনুযায়ী $\\vec{PQ} = <u>u</u>$ হয়।",
      "image": null,
      "formulas": [
        "P",
        "<u>u</u>",
        "P",
        "<u>u</u>",
        "P",
        "<u>u</u>",
        "|<u>u</u>|",
        "PQ",
        "\\vec{PQ} = <u>u</u>"
      ],
      "pdfPageStart": 278,
      "pdfPageEnd": 278,
      "printedPageStart": 273,
      "printedPageEnd": 273,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
