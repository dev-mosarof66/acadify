    {
      "id": "higher-math-9-10-bn-c12-t12.6-p014",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$\\therefore 2(3<u>u</u>) = 3(2<u>u</u>) = 2 \\times 3(<u>u</u>)$",
      "image": null,
      "formulas": [
