  "passages": [
    {
      "id": "higher-math-9-10-bn-c12-t12.6-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$<u>u</u>$ যেকোনো ভেক্টর এবং $m$ যেকোনো বাস্তব সংখ্যা হলে $m<u>u</u>$ দ্বারা কোন ভেক্টর বুঝায়, নিচে তা ব্যাখ্যা করা হলো।",
      "image": null,
      "formulas": [
        "<u>u</u>",
        "m",
        "m<u>u</u>"
      ],
