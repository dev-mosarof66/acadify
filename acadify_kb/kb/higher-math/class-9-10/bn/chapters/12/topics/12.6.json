    {
      "id": "higher-math-9-10-bn-c12-t12.6-p011",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$AC$ কে $G$ পর্যন্ত এরূপে বর্ধিত করি যেন $CD = DE = EF = FG = AB$ হয়।",
      "image": null,
      "formulas": [
        "AC",
        "G",
        "CD = DE = EF = FG = AB"
      ],
      "pdfPageStart": 282,
      "pdfPageEnd": 282,
