  "title": "দ্বিঘাত ফাংশন (Quadratic Function)",
  "chapter": 1,
  "ordinal": 35,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.34-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "দ্বিঘাত ফাংশন হলো একটি ফাংশন যা $y = ax^2 + bx + c$ সমীকরণ দ্বারা বর্গিত যেখানে $a, b$ ও $c$ বাস্তব সংখ্যা এবং $a \\neq 0$। প্রদত্ত ফাংশনে ধরি $a = 1, b = -4, c = -1$। তাহলে $y = ax^2 + bx + c$ কে লেখা যায় $y = x^2 - 4x - 1$। বর্গিত ফাংশন হতে $x$ ও $y$ এর সংশ্লিষ্ট মান পাওয়া যায় যা নিচের সারণিতে দেখানো হয়েছে।",
      "image": null,
      "formulas": [
        "y = ax^2 + bx + c",
        "a, b",
        "c",
        "a \\neq 0",
        "a = 1, b = -4, c = -1",
        "y = ax^2 + bx + c",
        "y = x^2 - 4x - 1",
        "x",
        "y"
      ],
      "pdfPageStart": 36,
