  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.18-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "নিচের বামের চিত্রে গাঢ় অংশটুকু $A \\cup (B \\cup C)$ এবং $(A \\cup B) \\cup C$ উভয় সেটই নির্দেশ করে। সুতরাং এখানে $A \\cup (B \\cup C) = (A \\cup B) \\cup C$। নিচের ডানের চিত্রে গাঢ় অংশটুকু $A \\cap (B \\cap C)$ এবং $(A \\cap B) \\cap C$ উভয় সেটই নির্দেশ করে। সুতরাং এখানে $(A \\cap B) \\cap C = A \\cap (B \\cap C)$।",
      "image": null,
      "formulas": [
        "A \\cup (B \\cup C)",
        "(A \\cup B) \\cup C",
        "A \\cup (B \\cup C) = (A \\cup B) \\cup C",
        "A \\cap (B \\cap C)",
        "(A \\cap B) \\cap C",
        "(A \\cap B) \\cap C = A \\cap (B \\cap C)"
      ],
      "pdfPageStart": 12,
