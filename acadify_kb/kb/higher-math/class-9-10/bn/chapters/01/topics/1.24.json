{
  "id": "higher-math-9-10-bn-c01-t1.24",
  "key": "1.24",
  "title": "সান্ত সেটের উপাদান সংখ্যা",
  "chapter": 1,
  "ordinal": 24,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.24-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সান্ত সেট $A$ এর উপাদান সংখ্যা $n(A)$ দ্বারা সূচিত করা হয়েছে এবং $n(A)$ নির্ধারণের পদ্ধতি ব্যাখ্যা করা হয়েছে। এবার মনে করি, $n(A) = p > 0$, $n(B) = q > 0$ যেখানে $A \\cap B = \\emptyset$।",
      "image": null,
      "formulas": [
        "A",
        "n(A)",
        "n(A)",
        "n(A) = p > 0",
        "n(B) = q > 0",
        "A \\cap B = \\emptyset"
      ],
      "pdfPageStart": 19,
      "pdfPageEnd": 19,
      "printedPageStart": 14,
      "printedPageEnd": 14,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c01-t1.24-p002",
      "kind": "figure",
      "section": null,
      "caption": null,
      "body": "drawing: Venn diagram showing sets A and B with elements 1 to p and 1 to q",
      "image": "p19-page_14_image_2_v2.jpg",
      "formulas": [],
      "pdfPageStart": 19,
      "pdfPageEnd": 19,
      "printedPageStart": 14,
      "printedPageEnd": 14,
