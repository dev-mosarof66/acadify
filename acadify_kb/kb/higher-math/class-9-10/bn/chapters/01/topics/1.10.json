        "C = \\{x : x \\in U, 6 < 2x < 17\\}",
        "D = \\{x : x \\in U, x^2 < 37\\}"
      ],
      "pdfPageStart": 9,
      "pdfPageEnd": 9,
      "printedPageStart": 4,
      "printedPageEnd": 4,
      "reviewReasons": [
        "verify-formula"
