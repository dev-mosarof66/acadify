        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c01-t1.19-p007",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ছ) $A$ ও $B$ যেকোনো সেট হলে, $A \\subseteq A \\cup B$ এবং $B \\subseteq A \\cup B$।",
      "image": null,
      "formulas": [
        "A",
        "B",
        "A \\subseteq A \\cup B",
        "B \\subseteq A \\cup B"
      ],
      "pdfPageStart": 15,
