      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ঘ) যদি $A \\subseteq \\emptyset$ হয়, তবে $A = \\emptyset$।",
      "image": null,
      "formulas": [
        "A \\subseteq \\emptyset",
        "A = \\emptyset"
