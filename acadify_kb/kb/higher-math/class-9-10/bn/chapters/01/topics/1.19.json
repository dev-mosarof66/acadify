    {
      "id": "higher-math-9-10-bn-c01-t1.19-p005",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ঙ) যদি $A \\subseteq B$ এবং $B \\subseteq C$ তবে, $A \\subseteq C$।",
      "image": null,
      "formulas": [
        "A \\subseteq B",
        "B \\subseteq C",
        "A \\subseteq C"
      ],
      "pdfPageStart": 15,
      "pdfPageEnd": 15,
