      "kind": "figure",
      "section": null,
      "caption": null,
      "body": "drawing: Venn diagram showing sets E, B, and S with values 35, 25, and 50",
      "image": "p21-page_16_chart_1_v2.jpg",
      "formulas": [],
      "pdfPageStart": 21,
      "pdfPageEnd": 21,
      "printedPageStart": 16,
      "printedPageEnd": 16,
