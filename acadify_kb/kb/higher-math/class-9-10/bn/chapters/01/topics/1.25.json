  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.25-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "বাস্তব সমস্যা সমাধানে ভেনচিত্র ব্যবহার করা হয়। এখানে উল্লেখ্য যে, প্রতি সেটের উপাদান সংখ্যা ভেনচিত্রে লেখা হবে, তা কয়েকটি উদাহরণের মাধ্যমে দেখানো হলো।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 20,
      "pdfPageEnd": 20,
      "printedPageStart": 15,
      "printedPageEnd": 15,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c01-t1.25-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**উদাহরণ ১৫.** ৫০জন লোকের মধ্যে ৩৫জন ইংরেজি বলতে পারে, ২৫জন ইংরেজি ও বাংলা বলতে পারে এবং প্রত্যেকেই দুটি ভাষার অন্তত একটি বলতে পারে। বাংলা বলতে পারে কতজন? কেবল মাত্র বাংলা বলতে পারে কতজন?",
      "image": null,
      "formulas": [],
      "pdfPageStart": 20,
      "pdfPageEnd": 20,
      "printedPageStart": 15,
      "printedPageEnd": 15,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c01-t1.25-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** মনে করি, সকল লোকের সেট $S$ এবং তাদের মধ্যে যারা ইংরেজি বলতে পারে তাদের সেট $E$, যারা বাংলা বলতে পারে তাদের সেট $B$।",
      "image": null,
      "formulas": [
        "S",
        "E",
        "B"
      ],
      "pdfPageStart": 21,
      "pdfPageEnd": 21,
      "printedPageStart": 16,
      "printedPageEnd": 16,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
