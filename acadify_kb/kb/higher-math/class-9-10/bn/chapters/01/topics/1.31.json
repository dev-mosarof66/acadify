  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.31-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "চিত্রে ফাংশন $f$ এর অধীনে সেট $A = \\{1, 2, 3\\}$ এবং $B = \\{5, 7, 9\\}$ বিবেচনা করি যেখানে $1 \\to 5, 2 \\to 7$ এবং $3 \\to 9$ অর্থাৎ $B$ এর প্রত্যেক উপাদান $A$ সেটের একটি উপাদানের প্রতিবিষ্ণ। এইরূপ ফাংশনকে সার্বিক ফাংশন বলা হয়।",
      "image": null,
