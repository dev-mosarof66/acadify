    {
      "id": "higher-math-9-10-bn-c01-t1.7-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ক) যেকোনো সেট $A$ এর জন্য $A \\subsetneq A$। এর কারণ $x \\in A \\implies x \\in A$।",
      "image": null,
      "formulas": [
        "A",
        "A \\subsetneq A",
        "x \\in A \\implies x \\in A"
      ],
      "pdfPageStart": 8,
      "pdfPageEnd": 8,
