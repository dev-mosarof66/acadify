    {
      "id": "higher-math-9-10-bn-c01-t1.9-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "অর্থাৎ $U \\setminus A = \\{x : x \\in U  এবং  x \\notin A\\}$।",
      "image": null,
      "formulas": [
        "U \\setminus A = \\{x : x \\in U  এবং  x \\notin A\\}"
      ],
      "pdfPageStart": 9,
      "pdfPageEnd": 9,
