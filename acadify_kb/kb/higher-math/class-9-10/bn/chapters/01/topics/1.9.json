  "title": "পূরক সেট (Complementary Set)",
  "chapter": 1,
  "ordinal": 9,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.9-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সার্বিক সেট $U$ এবং $A \\subseteq U$ হলে $A$ এর পূরক সেট হচ্ছে $U \\setminus A$।",
      "image": null,
      "formulas": [
        "U",
        "A \\subseteq U",
        "A",
        "U \\setminus A"
      ],
      "pdfPageStart": 9,
      "pdfPageEnd": 9,
