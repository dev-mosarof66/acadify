  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.30-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "নিচের ভেনচিত্রে $f$ ফাংশনের অধীনে ভিন্ন ভিন্ন সদস্যের প্রতিবিম্ব সর্বদা ভিন্ন।",
      "image": null,
      "formulas": [
        "f"
      ],
      "pdfPageStart": 32,
