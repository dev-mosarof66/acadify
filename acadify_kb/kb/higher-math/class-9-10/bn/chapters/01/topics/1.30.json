      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$\\implies \\frac{a}{a - 2} = 2 \\implies a = 2a - 4 \\implies a = 4$",
      "image": null,
      "formulas": [
        "\\implies \\frac{a}{a - 2} = 2 \\implies a = 2a - 4 \\implies a = 4"
