      "caption": null,
      "body": "ক) $f(x) = \\frac{x}{x - 2}, x \\neq 2$",
      "image": null,
      "formulas": [
        "f(x) = \\frac{x}{x - 2}, x \\neq 2"
      ],
      "pdfPageStart": 33,
