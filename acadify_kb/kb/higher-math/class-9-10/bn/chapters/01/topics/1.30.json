      "kind": "text",
      "section": null,
      "caption": null,
      "body": "অর্থাৎ $F(x_1) = F(x_2), \\therefore F$ এক-এক নয়।",
      "image": null,
      "formulas": [
        "F(x_1) = F(x_2), \\therefore F"
      ],
      "pdfPageStart": 33,
      "pdfPageEnd": 33,
      "printedPageStart": 28,
      "printedPageEnd": 28,
      "reviewReasons": [
        "verify-formula"
      ],
