    {
      "id": "higher-math-9-10-bn-c01-t1.30-p017",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$\\therefore f(5) = \\frac{5}{5 - 2} = \\frac{5}{3} = 1\\frac{2}{3}$",
      "image": null,
      "formulas": [
        "\\therefore f(5) = \\frac{5}{5 - 2} = \\frac{5}{3} = 1\\frac{2}{3}"
      ],
      "pdfPageStart": 33,
      "pdfPageEnd": 33,
      "printedPageStart": 28,
      "printedPageEnd": 28,
      "reviewReasons": [
        "verify-formula"
