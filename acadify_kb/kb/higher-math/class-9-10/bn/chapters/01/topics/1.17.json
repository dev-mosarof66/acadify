      "kind": "text",
      "section": null,
      "caption": null,
      "body": "মনে করি, $A = \\{1, 2, 4\\}$ এবং $B = \\{2, 3, 5\\}$ দুটি সেট।",
      "image": null,
      "formulas": [
        "A = \\{1, 2, 4\\}",
        "B = \\{2, 3, 5\\}"
      ],
      "pdfPageStart": 12,
      "pdfPageEnd": 12,
