      "kind": "text",
      "section": null,
      "caption": null,
      "body": "তাহলে, $A \\cup B = \\{1, 2, 4\\} \\cup \\{2, 3, 5\\} = \\{1, 2, 3, 4, 5\\}$।",
      "image": null,
      "formulas": [
        "A \\cup B = \\{1, 2, 4\\} \\cup \\{2, 3, 5\\} = \\{1, 2, 3, 4, 5\\}"
      ],
