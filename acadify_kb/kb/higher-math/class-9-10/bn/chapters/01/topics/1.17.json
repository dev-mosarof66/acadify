{
  "id": "higher-math-9-10-bn-c01-t1.17",
  "key": "1.17",
  "title": "বিনিময়বিধির প্রতিজ্ঞা দুটি যাচাইকরণ",
  "chapter": 1,
  "ordinal": 17,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c01-t1.17-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "নিচের বামের চিত্রে গাঢ় অংশটুকু $A \\cup B$ এবং $B \\cup A$ উভয় সেটই নির্দেশ করে। সুতরাং এখানে দেখা যাচ্ছে $A \\cup B = B \\cup A$। নিচের ডানের চিত্রে গাঢ় অংশটুকু $A \\cap B$ এবং $B \\cap A$ উভয় সেটই নির্দেশ করে। সুতরাং এখানে দেখা যাচ্ছে $A \\cap B = B \\cap A$।",
      "image": null,
      "formulas": [
        "A \\cup B",
        "B \\cup A",
        "A \\cup B = B \\cup A",
        "A \\cap B",
        "B \\cap A",
        "A \\cap B = B \\cap A"
      ],
      "pdfPageStart": 12,
      "pdfPageEnd": 12,
      "printedPageStart": 7,
      "printedPageEnd": 7,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
