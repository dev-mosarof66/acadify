      "kind": "text",
      "section": null,
      "caption": null,
      "body": "যদি $A$ ও $B$ সেট এমন হয় যে $A \\cap B = \\varnothing$, তবে $A$ ও $B$ কে নিশ্চেষ্ট সেট বলা হয়।",
      "image": null,
      "formulas": [
