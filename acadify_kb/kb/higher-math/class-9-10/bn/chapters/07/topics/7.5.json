    {
      "id": "higher-math-9-10-bn-c07-t7.5-p027",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "$\\therefore$ ধারাটির অসীমতক সমষ্টি, $S_\\infty = \\frac{a}{1 - r} = \\frac{\\frac{1}{3}}{1 - \\frac{1}{3}} = \\frac{1}{3} \\times \\frac{3}{2} = \\frac{1}{2}$",
      "image": null,
      "formulas": [
        "\\therefore",
        "S_\\infty = \\frac{a}{1 - r} = \\frac{\\frac{1}{3}}{1 - \\frac{1}{3}} = \\frac{1}{3} \\times \\frac{3}{2} = \\frac{1}{2}"
      ],
      "pdfPageStart": 145,
