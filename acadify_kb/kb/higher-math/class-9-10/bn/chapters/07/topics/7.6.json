      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "$\\therefore$ ধারাটির পঞ্চম পদ $= ar^{5-1} = \\frac{1}{4} \\cdot \\left(\\frac{1}{4}\\right)^{5-1} = \\left(\\frac{1}{4}\\right)^5 = \\frac{1}{4^5}$",
      "image": null,
      "formulas": [
        "\\therefore",
        "= ar^{5-1} = \\frac{1}{4} \\cdot \\left(\\frac{1}{4}\\right)^{5-1} = \\left(\\frac{1}{4}\\right)^5 = \\frac{1}{4^5}"
      ],
      "pdfPageStart": 147,
      "pdfPageEnd": 147,
      "printedPageStart": 142,
      "printedPageEnd": 142,
      "reviewReasons": [
        "verify-formula"
