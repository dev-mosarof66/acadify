      "kind": "formula",
      "section": "সমাধান:",
      "caption": null,
      "body": "$= \\frac{\\frac{1}{4} \\left\\{ 1 - \\left(\\frac{1}{4}\\right)^{10} \\right\\}}{1 - \\frac{1}{4}} = \\frac{\\frac{1}{4} \\left( 1 - \\frac{1}{4^{10}} \\right)}{\\frac{3}{4}} = \\frac{1}{4} \\times \\frac{4}{3} \\left( 1 - \\frac{1}{4^{10}} \\right) = \\frac{1}{3} \\left( 1 - \\frac{1}{4^{10}} \\right)$",
      "image": null,
      "formulas": [
        "= \\frac{\\frac{1}{4} \\left\\{ 1 - \\left(\\frac{1}{4}\\right)^{10} \\right\\}}{1 - \\frac{1}{4}} = \\frac{\\frac{1}{4} \\left( 1 - \\frac{1}{4^{10}} \\right)}{\\frac{3}{4}} = \\frac{1}{4} \\times \\frac{4}{3} \\left( 1 - \\frac{1}{4^{10}} \\right) = \\frac{1}{3} \\left( 1 - \\frac{1}{4^{10}} \\right)"
      ],
      "pdfPageStart": 147,
