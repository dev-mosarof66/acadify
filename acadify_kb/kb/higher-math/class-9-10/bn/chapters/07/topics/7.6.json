      "kind": "formula",
      "section": "সমাধান:",
      "caption": null,
      "body": "$\\therefore 0.\\dot{5} = \\frac{a}{1 - r} = \\frac{0.5}{1 - (0.1)} = \\frac{0.5}{0.9} = \\frac{5}{9}$",
      "image": null,
      "formulas": [
        "\\therefore 0.\\dot{5} = \\frac{a}{1 - r} = \\frac{0.5}{1 - (0.1)} = \\frac{0.5}{0.9} = \\frac{5}{9}"
