      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "ধারাটির প্রথম পদ, $a = \\frac{1}{4}$; সাধারণ অনুপাত, $r = \\frac{\\frac{1}{4^2}}{\\frac{1}{4}} = \\frac{1}{4} < 1$",
      "image": null,
      "formulas": [
        "a = \\frac{1}{4}",
        "r = \\frac{\\frac{1}{4^2}}{\\frac{1}{4}} = \\frac{1}{4} < 1"
