      "caption": null,
      "body": "ধারাটির প্রথম দশ পদের সমষ্টি $= \\frac{a(1 - r^n)}{1 - r} \\quad [n = 10]$",
      "image": null,
      "formulas": [
        "= \\frac{a(1 - r^n)}{1 - r} \\quad [n = 10]"
      ],
      "pdfPageStart": 147,
      "pdfPageEnd": 147,
      "printedPageStart": 142,
      "printedPageEnd": 142,
      "reviewReasons": [
        "verify-formula"
