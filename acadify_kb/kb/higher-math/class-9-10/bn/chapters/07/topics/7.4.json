      "id": "higher-math-9-10-bn-c07-t7.4-p007",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ক) $1 + 2 + 3 + 4 + \\dots$ খ) $1 - 1 + 1 - 1 + \\dots$",
      "image": null,
      "formulas": [
        "1 + 2 + 3 + 4 + \\dots",
        "1 - 1 + 1 - 1 + \\dots"
      ],
      "pdfPageStart": 143,
