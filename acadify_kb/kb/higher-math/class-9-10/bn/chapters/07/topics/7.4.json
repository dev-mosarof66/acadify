    {
      "id": "higher-math-9-10-bn-c07-t7.4-p015",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "উপরের উদাহরণ থেকে দেখা যায় যে, $n$ বিজোড় সংখ্যা হলে $n$ তম আংশিক সমষ্টি $S_n = 1$ এবং $n$ জোড় সংখ্যা হলে $n$ তম আংশিক সমষ্টি $S_n = 0$।",
      "image": null,
      "formulas": [
        "n",
        "n",
        "S_n = 1",
        "n",
        "n",
        "S_n = 0"
      ],
      "pdfPageStart": 143,
      "pdfPageEnd": 143,
