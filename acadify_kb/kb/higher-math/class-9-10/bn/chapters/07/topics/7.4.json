      "kind": "formula",
      "section": "সমাধান:",
      "caption": null,
      "body": "$$S_{10} = \\frac{10 \\times 11}{2} = 55 \\qquad S_{1000} = \\frac{1000 \\times 1001}{2} = 500500$$",
      "image": null,
      "formulas": [
        "S_{10} = \\frac{10 \\times 11}{2} = 55 \\qquad S_{1000} = \\frac{1000 \\times 1001}{2} = 500500"
      ],
      "pdfPageStart": 143,
      "pdfPageEnd": 143,
      "printedPageStart": 138,
