      "section": "সমাধান:",
      "caption": null,
      "body": "<table><tr><td>১ম আংশিক সমষ্টি $S_1 = 1$</td><td>৩য় আংশিক সমষ্টি $S_3 = 1 - 1 + 1 = 1$</td></tr>\n<tr><td>২য় আংশিক সমষ্টি $S_2 = 1 - 1 = 0$</td><td>৪র্থ আংশিক সমষ্টি $S_4 = 1 - 1 + 1 - 1 = 0$</td></tr></table>",
      "image": null,
