  "passages": [
    {
      "id": "higher-math-9-10-bn-c07-t7.1-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "নবম-দশম শ্রেণির গণিতে অনুক্রম ও সসীম ধারা সম্পর্কে বিস্তৃত আলোচনা করা হয়েছে। অনুক্রম ও অসীম ধারার মধ্যে একটা প্রত্যক্ষ সম্পর্ক রয়েছে। অনুক্রমের পদগুলোর পূর্বে যোগ চিহ্ন যুক্ত করে অসীম ধারা পাওয়া যায়। এ অধ্যায়ে অসীম ধারা নিয়ে আলোচনা করা হবে।",
      "image": null,
