    {
      "id": "higher-math-9-10-bn-c07-t7.1-p004",
      "kind": "text",
      "section": "অনুক্রম",
      "caption": null,
      "body": "নিচে দেখানো সম্পর্কটিতে প্রত্যেক স্বাভাবিক সংখ্যা $n$ এর সঙ্গে $n$ এর বর্গ $n^2$ সম্পর্কিত। অর্থাৎ স্বাভাবিক সংখ্যার সেট $N = \\{1, 2, 3, 4, \\dots\\}$ থেকে একটি নিয়মের মাধ্যমে তার বর্গসংখ্যার সেট $\\{1, 4, 9, 16, \\dots\\}$ পাওয়া যায়। এই সাজানো বর্গসংখ্যার সেটটি একটি অনুক্রম। যখন কতকগুলো রাশি একটা বিশেষ নিয়মে ক্রমাবয়ে এমনভাবে সাজানো হয় যে প্রত্যেক রাশি তার পূর্বে ও পরের রাশির সাথে কীভাবে সম্পর্কিত তা জানা যায়, তখন এভাবে সাজানো রাশিগুলোর সেটকে অনুক্রম (Sequence) বলা হয়।",
      "image": null,
      "formulas": [
        "n",
        "n",
        "n^2",
        "N = \\{1, 2, 3, 4, \\dots\\}",
        "\\{1, 4, 9, 16, \\dots\\}"
      ],
      "pdfPageStart": 141,
      "pdfPageEnd": 141,
      "printedPageStart": 136,
      "printedPageEnd": 136,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
