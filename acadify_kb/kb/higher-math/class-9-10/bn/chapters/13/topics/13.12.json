  "passages": [
    {
      "id": "higher-math-9-10-bn-c13-t13.12-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "কোনো অর্ধবৃত্ত ক্ষেত্রের ব্যাসকে অক্ষ ধরে ঐ ব্যাসের চতুর্দিকে অর্ধবৃত্ত ক্ষেত্রকে একবার ঘুরিয়ে আনলে যে ঘনবস্তু উৎপন্ন হয় তাকে গোলক বলে। অর্ধবৃত্তটির কেন্দ্রই গোলকের কেন্দ্র। এই ঘূর্ণনের ফলে অর্ধবৃত্ত যে তল উৎপন্ন করে তাই হল গোলকের তল।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 303,
      "pdfPageEnd": 303,
      "printedPageStart": 298,
      "printedPageEnd": 298,
      "reviewReasons": [],
      "needsReview": false
    },
