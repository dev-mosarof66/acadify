  "passages": [
    {
      "id": "higher-math-9-10-bn-c13-t13.0-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "বাস্তব জীবনে আমাদের বিভিন্ন আকারের ঘনবস্তুর প্রয়োজন এবং আমরা সেগুলো সর্বদা ব্যবহারও করে থাকি। এর মধ্যে সুসম আকারের ঘনবস্তু যেমন আছে, তেমনি আছে বিষম আকারের ঘনবস্তুও। তবে এই অধ্যায়ে সুসম আকারের ঘনবস্তু এবং দুটি সুসম ঘনবস্তুর সমন্বয়ে গঠিত যৌগিক ঘনবস্তুর আয়তন ও পৃষ্ঠতলের ক্ষেত্রফল নির্ণয় পদ্ধতি আলোচনা করা হবে।",
      "image": null,
      "formulas": [],
