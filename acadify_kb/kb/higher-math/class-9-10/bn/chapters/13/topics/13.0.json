    },
    {
      "id": "higher-math-9-10-bn-c13-t13.0-p008",
      "kind": "text",
      "section": "মৌলিক ধারণা",
      "caption": null,
      "body": "৪. তলের দৈর্ঘ্য ও প্রস্তুত আছে, উচ্চতা নেই। তাই তল দ্বিমাত্রিক। যেমন, নিচের চিত্রে $ABGF$।",
      "image": null,
      "formulas": [
        "ABGF"
      ],
      "pdfPageStart": 292,
      "pdfPageEnd": 292,
      "printedPageStart": 287,
      "printedPageEnd": 287,
      "reviewReasons": [
