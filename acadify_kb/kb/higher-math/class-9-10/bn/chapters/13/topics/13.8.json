    {
      "id": "higher-math-9-10-bn-c13-t13.8-p007",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$= 2(ABCD  তলের ক্ষেত্রফল + ABB'A'  তলের ক্ষেত্রফল + ADD'A'  তলের ক্ষেত্রফল)$$",
      "image": null,
      "formulas": [
