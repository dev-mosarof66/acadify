    {
      "id": "higher-math-9-10-bn-c13-t13.8-p012",
      "kind": "text",
      "section": "২. ঘনক (Cube) আকৃতির ঘনবস্তু",
      "caption": null,
      "body": "**ক) সমগ্র তলের ক্ষেত্রফল = $2(a^2 + a^2 + a^2) = 6a^2$ বর্গ একক**",
      "image": null,
      "formulas": [
        "2(a^2 + a^2 + a^2) = 6a^2"
      ],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
