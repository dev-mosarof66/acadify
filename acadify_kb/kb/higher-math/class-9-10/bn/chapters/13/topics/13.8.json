    {
      "id": "higher-math-9-10-bn-c13-t13.8-p011",
      "kind": "text",
      "section": "২. ঘনক (Cube) আকৃতির ঘনবস্তু",
      "caption": null,
      "body": "ঘনকের ক্ষেত্রে, $a = b = c$, অতএব",
      "image": null,
      "formulas": [
        "a = b = c"
      ],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
