    },
    {
      "id": "higher-math-9-10-bn-c13-t13.8-p020",
      "kind": "text",
      "section": "২. ঘনক (Cube) আকৃতির ঘনবস্তু",
      "caption": null,
      "body": "এবং আয়তন $= 12 \\times 9 \\times 6 = 648$ ঘনমিটার।",
      "image": null,
