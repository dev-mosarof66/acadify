    {
      "id": "higher-math-9-10-bn-c13-t13.8-p002",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "তিনজোড়া সমান্তরাল সমতল দ্বারা আবদ্ধ ঘনবস্তুকে সামান্তরিক ঘনবস্তু বলা হয়। এই ছয়টি সমতলের প্রত্যেকটি একটি সামান্তরিক এবং বিপরীত পৃষ্ঠগুলো সর্বতোভাবে সমান। সামান্তরিক ঘনবস্তুর ছয়টি তলে বিভক্ত বারটি ধার আছে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c13-t13.8-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "যে সামান্তরিক ঘনবস্তুর পৃষ্ঠতলগুলো আয়তক্ষেত্র, তাকে আয়তাকার ঘনবস্তু বলা হয়। যে আয়তাকার ঘনবস্তুর পৃষ্ঠতলগুলো বর্গক্ষেত্র, তাকে ঘনক বলা হয়। উপরিউক্ত চিত্রে আয়তাকার ঘনবস্তুর এবং ঘনকের পৃষ্ঠগুলো $ABCD$, $A'B'C'D'$, $BCC'B'$, $ADD'A'$, $ABB'A'$, $DCC'D'$ এবং ধারগুলো $AB$, $A'B'$, $CD$, $C'D'$, $BC$, $B'C'$, $AD$, $A'D'$, $AA'$, $BB'$, $CC'$, $DD'$। তবে চিত্রে কেবল একটি কর্ণ $BD'$ দেখানো হয়েছে, অন্যগুলো অনুরূপভাবে আঁকতে হবে।",
      "image": null,
      "formulas": [
        "ABCD",
        "A'B'C'D'",
        "BCC'B'",
        "ADD'A'",
        "ABB'A'",
        "DCC'D'",
        "AB",
        "A'B'",
        "CD",
        "C'D'",
        "BC",
        "B'C'",
        "AD",
        "A'D'",
        "AA'",
        "BB'",
        "CC'",
        "DD'",
        "BD'"
      ],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c13-t13.8-p004",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "মনে করি, আয়তাকার ঘনবস্তুর দৈর্ঘ্য, প্রস্থ ও উচ্চতা যথাক্রমে $AB = a$ একক, $AD = b$ একক এবং $AA' = c$ একক।",
      "image": null,
      "formulas": [
        "AB = a",
        "AD = b",
        "AA' = c"
      ],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c13-t13.8-p005",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**ক) আয়তাকার ঘনবস্তুর সমগ্র তলের ক্ষেত্রফল (Area of the whole surface)**",
      "image": null,
      "formulas": [],
      "pdfPageStart": 298,
      "pdfPageEnd": 298,
      "printedPageStart": 293,
      "printedPageEnd": 293,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c13-t13.8-p006",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$= ছয়টি পৃষ্ঠের ক্ষেত্রফলের সমষ্টি$$",
      "image": null,
      "formulas": [
        "= ছয়টি পৃষ্ঠের ক্ষেত্রফলের সমষ্টি"
      ],
