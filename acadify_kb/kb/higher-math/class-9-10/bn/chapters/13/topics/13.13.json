    {
      "id": "higher-math-9-10-bn-c13-t13.13-p019",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "ক) দেওয়া আছে, গোলকের বাইরের ব্যাস 15 সে.মি.",
      "image": null,
      "formulas": [],
      "pdfPageStart": 307,
      "pdfPageEnd": 307,
      "printedPageStart": 302,
      "printedPageEnd": 302,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c13-t13.13-p020",
      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "$\\therefore$ গোলকের বাইরের ব্যাসার্ধ $= \\frac{15}{2}$ সে.মি. $= 7.5$ সে.মি. এবং গোলকের বেধ 2 সে.মি.",
      "image": null,
      "formulas": [
        "\\therefore",
        "= \\frac{15}{2}",
        "= 7.5"
      ],
      "pdfPageStart": 307,
      "pdfPageEnd": 307,
      "printedPageStart": 302,
      "printedPageEnd": 302,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
