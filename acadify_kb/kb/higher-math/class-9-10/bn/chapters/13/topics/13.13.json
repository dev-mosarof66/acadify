      "kind": "text",
      "section": "সমাধান:",
      "caption": null,
      "body": "$\\therefore$ গোলকের ফাঁপা অংশের ব্যাসার্ধ $= (7.5 - 2)$ সে.মি. $= 5.5$ সে.মি.",
      "image": null,
      "formulas": [
        "\\therefore",
        "= (7.5 - 2)",
        "= 5.5"
      ],
      "pdfPageStart": 307,
      "pdfPageEnd": 307,
      "printedPageStart": 302,
      "printedPageEnd": 302,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
