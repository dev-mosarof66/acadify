      "id": "higher-math-9-10-bn-c13-t13.13-p016",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "ক) গোলকের ফাঁপা অংশের আয়তন নির্ণয় করো।",
      "image": null,
      "formulas": [],
