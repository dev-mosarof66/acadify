  "passages": [
    {
      "id": "higher-math-9-10-bn-c02-t2.4-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "দুটি বহুপদীর যোগফল, বিয়োগফল এবং গুণফল সবসময় বহুপদী হয়। দুটি বহুপদীর ভাগফল বহুপদী হতেও পারে নাও হতে পারে। যেমন $x^3$ দ্বারা $x$ কে ভাগ করলে ভাগফল যদি $x^{-2}$ ধরা হয় তখন এটি বহুপদী নয়। কিন্তু $x$ কে ভাগশেষ ধরে নিলে সেক্ষেত্রে ভাগফল $0$ একটি বহুপদী।",
      "image": null,
      "formulas": [
        "x^3",
        "x",
        "x^{-2}",
        "x",
        "0"
      ],
      "pdfPageStart": 46,
      "pdfPageEnd": 46,
      "printedPageStart": 41,
      "printedPageEnd": 41,
      "reviewReasons": [
