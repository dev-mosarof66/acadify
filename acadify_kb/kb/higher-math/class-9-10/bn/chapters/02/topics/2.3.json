  "chapter": 2,
  "ordinal": 3,
  "passages": [
    {
      "id": "higher-math-9-10-bn-c02-t2.3-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$x, y$ ও $z$ চলকের বহুপদীর পদগুলো $cx^p y^q z^r$ আকারের হয়। যেখানে $c$ (ধ্রুবক) পদটির সহগ এবং $p, q, r$ অক্ষগাত্বক পূর্ণসংখ্যা। এখানে $p + q + r$ কে এই পদের মাত্রা এবং বহুপদীতে উল্লিখিত পদসমূহের গরিষ্ঠ মাত্রাকে বহুপদীটির মাত্রা বলা হয়। এরূপ বহুপদিকে $P(x, y, z)$ আকারের প্রতীক দ্বারা সূচিত করা হয়। যেমন, $P(x, y, z) = x^3 + y^3 + z^3 - 3xyz$ বহুপদীর মাত্রা 3 এবং $P(1, 1, -2) = 1 + 1 - 8 + 6 = 0$।",
      "image": null,
      "formulas": [
        "x, y",
        "z",
        "cx^p y^q z^r",
        "c",
        "p, q, r",
        "p + q + r",
        "P(x, y, z)",
        "P(x, y, z) = x^3 + y^3 + z^3 - 3xyz",
        "P(1, 1, -2) = 1 + 1 - 8 + 6 = 0"
      ],
      "pdfPageStart": 45,
      "pdfPageEnd": 45,
      "printedPageStart": 40,
      "printedPageEnd": 40,
