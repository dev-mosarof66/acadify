      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$= \\frac{2x}{x^2 + a^2} + \\frac{4x^3}{a^4 - x^4} = \\frac{2x}{x^2 + a^2} \\left[ 1 + \\frac{2x^2}{a^2 - x^2} \\right]$$",
      "image": null,
      "formulas": [
        "= \\frac{2x}{x^2 + a^2} + \\frac{4x^3}{a^4 - x^4} = \\frac{2x}{x^2 + a^2} \\left[ 1 + \\frac{2x^2}{a^2 - x^2} \\right]"
      ],
      "pdfPageStart": 60,
      "pdfPageEnd": 60,
