      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$= \\frac{4x^3}{x^4 + a^4} \\left( 1 + \\frac{2x^4}{a^4 - x^4} \\right) = \\frac{4x^3}{x^4 + a^4} \\times \\frac{a^4 - x^4 + 2x^4}{a^4 - x^4}$",
      "image": null,
      "formulas": [
        "= \\frac{4x^3}{x^4 + a^4} \\left( 1 + \\frac{2x^4}{a^4 - x^4} \\right) = \\frac{4x^3}{x^4 + a^4} \\times \\frac{a^4 - x^4 + 2x^4}{a^4 - x^4}"
      ],
      "pdfPageStart": 59,
      "pdfPageEnd": 59,
