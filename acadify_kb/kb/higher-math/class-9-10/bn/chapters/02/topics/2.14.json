    {
      "id": "higher-math-9-10-bn-c02-t2.14-p026",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$\\therefore$ দ্বিতীয়, তৃতীয় এবং চতুর্থ পদের যোগফল",
      "image": null,
