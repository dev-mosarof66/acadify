      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$= \\frac{4x^3}{x^4 + a^4} + \\frac{8x^7}{a^8 - x^8} = \\frac{4x^3}{x^4 + a^4} + \\frac{8x^7}{(x^4 + a^4)(a^4 - x^4)}$",
      "image": null,
      "formulas": [
        "= \\frac{4x^3}{x^4 + a^4} + \\frac{8x^7}{a^8 - x^8} = \\frac{4x^3}{x^4 + a^4} + \\frac{8x^7}{(x^4 + a^4)(a^4 - x^4)}"
      ],
      "pdfPageStart": 59,
      "pdfPageEnd": 59,
