    {
      "id": "higher-math-9-10-bn-c02-t2.14-p022",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**সমাধান:** প্রদত্ত রাশির তৃতীয় ও চতুর্থ পদের যোগফল",
      "image": null,
      "formulas": [],
      "pdfPageStart": 59,
