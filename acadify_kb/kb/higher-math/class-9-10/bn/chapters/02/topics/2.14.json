    {
      "id": "higher-math-9-10-bn-c02-t2.14-p017",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "কিন্তু $x^2(y - z) + y^2(z - x) + z^2(x - y) = -(x - y)(y - z)(z - x)$",
      "image": null,
      "formulas": [
        "x^2(y - z) + y^2(z - x) + z^2(x - y) = -(x - y)(y - z)(z - x)"
