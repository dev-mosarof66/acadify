      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$= \\frac{(ax + 1)^2(y - z) + (ay + 1)^2(z - x) + (az + 1)^2(x - y)}{(x - y)(y - z)(z - x)}$ (1)",
      "image": null,
      "formulas": [
        "= \\frac{(ax + 1)^2(y - z) + (ay + 1)^2(z - x) + (az + 1)^2(x - y)}{(x - y)(y - z)(z - x)}"
