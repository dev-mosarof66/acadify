      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$\\therefore AB^2 = AD^2 + CD^2 + BC^2 + 2 \\cdot BC \\cdot CD \\dots\\dots (1)$$",
      "image": null,
      "formulas": [
