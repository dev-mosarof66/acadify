    {
      "id": "higher-math-9-10-bn-c03-t3.1-p007",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "সুতরাং পিথাগোরাসের উপপাদ্য অনুসারে",
      "image": null,
      "formulas": [],
      "pdfPageStart": 71,
