      "printedPageEnd": 66,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c03-t3.1-p008",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$\\begin{aligned}\nAB^2 &= AD^2 + BD^2 \\\\\n&= AD^2 + (BC + CD)^2 & [\\because BD = BC + CD] \\\\\n&= AD^2 + BC^2 + CD^2 + 2 \\cdot BC \\cdot CD\n\\end{aligned}$$",
      "image": null,
      "formulas": [
        "\\begin{aligned}\nAB^2 &= AD^2 + BD^2 \\\\\n&= AD^2 + (BC + CD)^2 & [\\because BD = BC + CD] \\\\\n&= AD^2 + BC^2 + CD^2 + 2 \\cdot BC \\cdot CD\n\\end{aligned}"
      ],
      "pdfPageStart": 71,
      "pdfPageEnd": 71,
      "printedPageStart": 66,
      "printedPageEnd": 66,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
