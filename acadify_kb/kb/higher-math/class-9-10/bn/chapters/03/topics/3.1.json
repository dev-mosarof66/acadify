      "printedPageEnd": 66,
      "reviewReasons": [],
      "needsReview": false
    },
    {
      "id": "higher-math-9-10-bn-c03-t3.1-p003",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "**বিশেষ নির্বাচন:** মনে করি, $ABC$ ত্রিভুজের $\\angle BCA$ স্তূলকোণ, $AB$ স্তূলকোণের বিপরীত বাহু এবং স্তূলকোণের সমনিহিত বাহুদ্বয় $BC$ ও $AC$।",
      "image": null,
      "formulas": [
        "ABC",
