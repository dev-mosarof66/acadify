    {
      "id": "higher-math-9-10-bn-c03-t3.1-p004",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "$BC$ বাহুর বর্ধিতাংশের উপর $AC$ বাহুর লম্ব অভিক্ষেপ $CD$ (নিচের চিত্র)। প্রমাণ করতে হবে যে, $AB^2 = AC^2 + BC^2 + 2 \\cdot BC \\cdot CD$",
      "image": null,
      "formulas": [
        "BC",
        "AC",
        "CD",
        "AB^2 = AC^2 + BC^2 + 2 \\cdot BC \\cdot CD"
      ],
