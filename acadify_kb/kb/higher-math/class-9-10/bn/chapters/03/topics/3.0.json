    },
    {
      "id": "higher-math-9-10-bn-c03-t3.0-p004",
      "kind": "text",
      "section": "পিথাগোরাস সমপর্কিত আলোচনা",
      "caption": null,
      "body": "গ্রিস্টের জন্মের প্রায় ৬০০ বছর আগে বিখ্যাত গ্রিক পণ্ডিত পিথাগোরাস (জন্ম গ্রিস্টপূর্ব ৫৭০-মৃত্যু গ্রিস্টপূর্ব ৪৯৫) সমকোণী ত্রিভুজের ক্ষেত্রে একটি অত্যন্ত গুরুত্বপূর্ণ উপপাদ্য (theorem) বর্ণনা করেন। এই উপপাদ্যটি তার নামানুসারে পিথাগোরাসের উপপাদ্য বলে পরিচিত। জানা যায় তারও প্রায় ১০০০ বছর আগে মিশরীয় ভূমি জরিপকারীগণের এই উপপাদ্যটি সম্বন্ধে ধারণা ছিল। পিথাগোরাসের উপপাদ্য বিভিন্নভাবে প্রমাণ করা যায়। নিম্ন মাধ্যমিক পর্যায়ে এর দুটি প্রমাণ দেওয়া আছে। তাই এখানে কোনো প্রমাণ দেওয়া হবে না। এখানে শুধুমাত্র এর বর্ণনা ও কিছু আলোচনা থাকবে।",
      "image": null,
      "formulas": [],
      "pdfPageStart": 68,
      "pdfPageEnd": 68,
      "printedPageStart": 63,
      "printedPageEnd": 63,
      "reviewReasons": [],
