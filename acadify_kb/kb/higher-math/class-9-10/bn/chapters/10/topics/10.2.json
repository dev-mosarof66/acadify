    {
      "id": "higher-math-9-10-bn-c10-t10.2-p012",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "আমরা যদি ভালভাবে খেয়াল করি তাহলে বুঝতে পারব এই পদ্ধতির একটি বিশেষ দূর্বলতা আছে। যেমন আমরা যদি $(1 + y)^5$ এর বিস্তৃতি জানতে চাই তাহলে $(1 + y)^4$ এর বিস্তৃতি জানা দরকার। আবার যেকোনো দ্বিপদী সহগ জানার জন্য তার ঠিক উপরের পূর্ববর্তী দুটি সহগ জানা প্রয়োজন। এই অবস্থা থেকে উত্তরনের জন্য আমরা সরাসরি দ্বিপদী সহগ নির্ণয়ের কৌশল বের করতে চাই। প্যাসকেলের ত্রিভুজ থেকে আমরা দেখতে পাই দ্বিপদী বিস্তৃতির সহগগুলো যাত $n$ এবং পদটি কোন অবস্থানে আছে তার উপর নির্ভরশীল। আমরা একটি নতুন সাংকেতিক চিহ্ন $\\binom{n}{r}$ বিবেচনা করি যেখানে $n$ যাত এবং $r$ পদের অবস্থানের সাথে সম্পর্কিত। উদাহরণস্বরূপ যদি $n = 4$ হয় তবে পদসংখ্যা হবে 5 টি। আমরা পদগুলি নিম্নোক্ত উপায়ে লিখি।",
      "image": null,
      "formulas": [
        "(1 + y)^5",
        "(1 + y)^4",
        "n",
        "\\binom{n}{r}",
        "n",
        "r",
        "n = 4"
      ],
      "pdfPageStart": 230,
      "pdfPageEnd": 230,
      "printedPageStart": 225,
      "printedPageEnd": 225,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
