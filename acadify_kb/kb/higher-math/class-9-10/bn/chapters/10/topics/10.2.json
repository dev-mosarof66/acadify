    {
      "id": "higher-math-9-10-bn-c10-t10.2-p015",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "নতুন চিহ্ন ব্যবহার করে সহগ: $\\binom{4}{0}, \\binom{4}{1}, \\binom{4}{2}, \\binom{4}{3}, \\binom{4}{4}$ এখানে, $\\binom{4}{0} = 1$, $\\binom{4}{1} = \\frac{4}{1} = 4$, $\\binom{4}{2} = \\frac{4 \\times 3}{1 \\times 2} = 6$, $\\binom{4}{3} = \\frac{4 \\times 3 \\times 2}{1 \\times 2 \\times 3} = 4$, এবং\n$\\binom{4}{4} = \\frac{4 \\times 3 \\times 2 \\times 1}{1 \\times 2 \\times 3 \\times 4} = 1$",
      "image": null,
      "formulas": [
        "\\binom{4}{0}, \\binom{4}{1}, \\binom{4}{2}, \\binom{4}{3}, \\binom{4}{4}",
        "\\binom{4}{0} = 1",
        "\\binom{4}{1} = \\frac{4}{1} = 4",
        "\\binom{4}{2} = \\frac{4 \\times 3}{1 \\times 2} = 6",
        "\\binom{4}{3} = \\frac{4 \\times 3 \\times 2}{1 \\times 2 \\times 3} = 4",
        "\\binom{4}{4} = \\frac{4 \\times 3 \\times 2 \\times 1}{1 \\times 2 \\times 3 \\times 4} = 1"
      ],
