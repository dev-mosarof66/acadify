      "section": null,
      "caption": null,
      "body": "সাধারণত, একটি সরলরেখা যখন $A(x_1, y_1)$ ও $B(x_2, y_2)$ বিন্দু দিয়ে অতিক্রম করে তখন এর ঢাল ($m$) কে আমরা",
      "image": null,
      "formulas": [
        "A(x_1, y_1)",
        "B(x_2, y_2)",
        "m"
      ],
      "pdfPageStart": 262,
      "pdfPageEnd": 262,
      "printedPageStart": 257,
      "printedPageEnd": 257,
      "reviewReasons": [
        "verify-formula"
      ],
      "needsReview": true
    },
    {
      "id": "higher-math-9-10-bn-c11-t11.8-p006",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$m = \\frac{y_2 - y_1}{x_2 - x_1} \\left[ \\frac{rise}{run} \\right] = \\frac{ওঠা}{হাঁটা}  দ্বারা প্রকাশ করে থাকি।$$",
      "image": null,
      "formulas": [
