    {
      "id": "higher-math-9-10-bn-c11-t11.5-p004",
      "kind": "formula",
      "section": null,
      "caption": null,
      "body": "$$= \\frac{1}{2} \\begin{vmatrix} x_1 & x_2 & x_3 & x_1 \\\\ y_1 & y_2 & y_3 & y_1 \\end{vmatrix} + \\frac{1}{2} \\begin{vmatrix} x_1 & x_3 & x_4 & x_1 \\\\ y_1 & y_3 & y_4 & y_1 \\end{vmatrix}$$",
      "image": null,
      "formulas": [
        "= \\frac{1}{2} \\begin{vmatrix} x_1 & x_2 & x_3 & x_1 \\\\ y_1 & y_2 & y_3 & y_1 \\end{vmatrix} + \\frac{1}{2} \\begin{vmatrix} x_1 & x_3 & x_4 & x_1 \\\\ y_1 & y_3 & y_4 & y_1 \\end{vmatrix}"
      ],
