  "passages": [
    {
      "id": "higher-math-9-10-bn-c14-t14.4-p001",
      "kind": "text",
      "section": null,
      "caption": null,
      "body": "আগেই বলা হয়েছে, কোনো পরীক্ষায় সম্ভাব্য ফলাফলগুলো নিয়ে যে ক্ষেত্র তৈরি হয় তাকে নমুনাক্ষেত্র বলে। অনেক পরীক্ষায় নমুনাক্ষেত্রের আকার বেশ বড় হয়। এসব ক্ষেত্রে নমুনা বিন্দু গণনা করা ও নমুনাক্ষেত্র তৈরি করা সময় সাপেক্ষ এমন কি ভুল হওয়ার সম্ভাবনাও থাকে। সেক্ষেত্রে আমরা probability tree এর সাহায্যে নমুনাক্ষেত্র তৈরি করতে পারি ও বিভিন্ন ঘটনার সম্ভাবনাও বের করতে পারি।",
      "image": null,
      "formulas": [],
